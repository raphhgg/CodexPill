{
  "kind": "product_scenario_manifest",
  "schemaVersion": "kite.validation.scenarios.v2",
  "product": {
    "id": "codexpill",
    "name": "CodexPill",
    "platforms": ["macos"]
  },
  "features": [
    {
      "id": "menubar-default-read-state",
      "title": "Menubar default read state",
      "acceptanceCriteria": [
        {
          "id": "default-menu-shape-does-not-claim-live-state",
          "statement": "The hosted menu projection presents the normal saved-account shape without claiming live auth, switching, preview rendering, or native menu-bar behavior."
        }
      ]
    },
    {
      "id": "active-account-truth",
      "title": "Active account truth",
      "acceptanceCriteria": [
        {
          "id": "active-account-unmatched-does-not-lie",
          "statement": "If local auth does not match a saved account, CodexPill must not present any saved account as active."
        }
      ]
    },
    {
      "id": "account-catalog-empty-state",
      "title": "Account catalog empty state",
      "acceptanceCriteria": [
        {
          "id": "empty-catalog-guides-to-add-account",
          "statement": "When no accounts are saved, CodexPill must guide the user toward adding an account and must not imply that account switching is possible."
        }
      ]
    }
  ],
  "scenarios": [
    {
      "id": "hosted-menu-default",
      "title": "Hosted menu default",
      "featureId": "menubar-default-read-state",
      "acceptanceCriteria": [
        "default-menu-shape-does-not-claim-live-state"
      ],
      "targetSurface": "CodexPill hosted menu validation view",
      "validationModes": ["unit_only"],
      "suites": ["smoke", "deterministic"],
      "validationIntent": {
        "featureRisk": ["ui_visual", "static_ui", "privacy"],
        "primaryProof": "deterministic-ui",
        "supportingProof": ["privacy-redaction"],
        "requiredEvidence": ["screenshot", "ui-tree", "scenario-summary"],
        "nonClaims": [
          "Does not prove SwiftUI preview rendering.",
          "Does not prove the live macOS menu bar surface.",
          "Does not prove live Codex account or app-server state."
        ],
        "liveOptIn": {
          "required": false
        }
      },
      "nonRegression": {
        "tier": "smoke",
        "runWhen": [
          "local-handoff",
          "menubar-ui-changed",
          "scenario-fixture-changed"
        ],
        "blocking": true
      },
      "proof": {
        "layer": "deterministic-ui",
        "artifactSource": "hosted-validation-view",
        "nonClaims": [
          "Does not prove SwiftUI preview rendering.",
          "Does not prove the live macOS menu bar surface.",
          "Does not prove live Codex account or app-server state."
        ]
      },
      "command": {
        "run": "make verify-ui SCENARIO=hosted-menu-default"
      },
      "expectedArtifacts": [
        {
          "id": "hosted-menu-default-screenshot",
          "kind": "visual_snapshot",
          "path": "build/verification/hosted-menu-default/screenshots/hosted-menu-default.png",
          "claimScope": ["deterministic-hosted-view"],
          "redactionStatus": "sanitized"
        },
        {
          "id": "hosted-menu-default-tree",
          "kind": "semantic_snapshot",
          "path": "build/verification/hosted-menu-default/ui-tree.json",
          "claimScope": ["semantic-ui-tree"],
          "redactionStatus": "sanitized"
        },
        {
          "id": "hosted-menu-default-summary",
          "kind": "reconciliation_report",
          "path": "build/verification/hosted-menu-default/scenario-summary.json",
          "claimScope": ["deterministic-reconciled"],
          "redactionStatus": "sanitized"
        }
      ],
      "expectedMetadata": {
        "scenario": "hosted-menu-default"
      },
      "privacy": {
        "fixtureData": "synthetic",
        "restrictedEvidence": [
          "account_data",
          "hostname",
          "raw_local_path",
          "private_product_data",
          "token"
        ]
      }
    },
    {
