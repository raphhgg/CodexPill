{
  "kind": "product_scenario_manifest",
  "schemaVersion": "kite.validation.scenarios.v2",
  "product": {
    "id": "codexpill",
    "name": "CodexPill",
    "platforms": ["macos"]
  },
  "features": [
    {
      "id": "menubar-default-read-state",
      "title": "Menubar default read state",
      "acceptanceCriteria": [
        {
          "id": "default-menu-shape-does-not-claim-live-state",
          "statement": "The hosted menu projection presents the normal saved-account shape without claiming live auth, switching, preview rendering, or native menu-bar behavior."
        }
      ]
    },
    {
      "id": "menubar-busy-status",
      "title": "Menubar busy status",
      "acceptanceCriteria": [
        {
          "id": "busy-status-visible-and-conflicting-actions-disabled",
          "statement": "When CodexPill is busy, the hosted menu projection must show the busy status message and disable conflicting immediate actions such as Add Account."
        }
      ]
    },
    {
      "id": "active-account-truth",
      "title": "Active account truth",
      "acceptanceCriteria": [
        {
          "id": "active-account-unmatched-does-not-lie",
          "statement": "If local auth does not match a saved account, CodexPill must not present any saved account as active."
        }
      ]
    },
    {
      "id": "account-catalog-empty-state",
      "title": "Account catalog empty state",
      "acceptanceCriteria": [
        {
          "id": "empty-catalog-guides-to-add-account",
          "statement": "When no accounts are saved, CodexPill must guide the user toward adding an account and must not imply that account switching is possible."
        }
      ]
    },
    {
      "id": "account-catalog-overflow",
      "title": "Account catalog overflow",
      "acceptanceCriteria": [
        {
          "id": "overflow-keeps-hidden-accounts-discoverable",
          "statement": "When saved accounts exceed the visible account limit, CodexPill must show the configured visible rows and keep hidden saved accounts discoverable through More Accounts… without changing account submenu behavior."
        }
      ]
    },
    {
      "id": "token-usage-menu-card",
      "title": "Token Usage menu card",
      "acceptanceCriteria": [
        {
          "id": "disabled-card-hidden-in-main-menu",
          "statement": "When Token Usage is disabled, CodexPill must not render the Token Usage card in the main active-account area."
        },
        {
          "id": "ready-card-shows-local-aggregate-without-attribution",
          "statement": "When Token Usage is enabled and aggregate data exists, CodexPill must show a compact Last 30 Days card without implying saved-account, workspace, organization, or remote-host usage attribution."
        },
        {
          "id": "loading-progress-is-honest-and-private",
          "statement": "When Token Usage is enabled and no cached aggregate exists, CodexPill must show active loading/progress feedback without fake percentages, raw session details, file paths, account, workspace, organization, or remote-host attribution."
        }
      ]
    },
    {
      "id": "launch-at-login-menu-state",
      "title": "Launch at Login menu state",
      "acceptanceCriteria": [
        {
          "id": "menu-states-reflect-login-item-state",
          "statement": "Preferences must present enabled, disabled, requires-approval, and unavailable Launch at Login states truthfully without implying registration success when macOS reports a blocked or unavailable state."
        }
      ]
    },
    {
      "id": "status-bar-closed-state",
      "title": "Status bar closed state",
      "acceptanceCriteria": [
        {
          "id": "closed-status-item-icon-and-text-visible",
          "statement": "The closed status item must expose a visible icon and the expected optional text label for synthetic active-account usage state."
        }
      ]
    }
  ],
  "scenarios": [
    {
      "id": "hosted-menu-default",
      "title": "Hosted menu default",
      "featureId": "menubar-default-read-state",
      "acceptanceCriteria": [
        "default-menu-shape-does-not-claim-live-state"
      ],
      "targetSurface": "CodexPill hosted menu validation view",
      "validationModes": ["unit_only"],
      "suites": ["smoke", "deterministic"],
      "validationIntent": {
        "featureRisk": ["ui_visual", "static_ui", "privacy"],
        "primaryProof": "deterministic-ui",
        "supportingProof": ["privacy-redaction"],
        "requiredEvidence": ["screenshot", "ui-tree", "scenario-summary"],
        "nonClaims": [
          "Does not prove SwiftUI preview rendering.",
          "Does not prove the live macOS menu bar surface.",
          "Does not prove live Codex account or app-server state."
        ],
        "liveOptIn": {
          "required": false
        }
      },
      "nonRegression": {
        "tier": "smoke",
        "runWhen": [
          "local-handoff",
          "menubar-ui-changed",
          "scenario-fixture-changed"
