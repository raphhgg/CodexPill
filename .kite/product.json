{
  "kind": "product_scenario_pack",
  "schemaVersion": "kite.validation.scenario-pack.v1",
  "product": {
    "id": "codexpill",
    "name": "CodexPill",
    "platforms": [
      "macos"
    ]
  },
  "scenarioDefaults": {
    "commandProfile": "selected-tests",
    "commandProfiles": {
      "selected-tests": {
        "run": "make verify-selected-tests SCENARIO={scenarioId} TEST_SELECTORS=\"{commandInput.testSelectors}\""
      },
      "make-target": {
        "run": "make {commandTarget} SCENARIO={scenarioId}"
      }
    },
    "validationModes": [
      "unit_only"
    ],
    "nonRegression": {
      "tier": "changed-feature",
      "runWhen": [
        "local-handoff"
      ],
      "blocking": true
    },
    "privacy": {
      "fixtureData": "synthetic",
      "restrictedEvidence": [
        "account_data",
        "hostname",
        "raw_local_path",
        "private_product_data",
        "token"
      ]
    },
    "commandInputTemplates": {
      "testSelectors": {
        "item": "-only-testing:{value}",
        "separator": " "
      }
    },
    "presets": {
      "hosted-ui-structure": {
        "proof": {
          "layer": "ui-structure-contract",
          "artifactSource": "hosted-menu-structure-exporter",
          "nonClaims": [
            "Does not prove pixel rendering, typography, spacing, or screenshot visual fidelity.",
            "Does not prove native menu opening, native click routing, focus, or hittability.",
            "Does not prove the live macOS menu bar surface."
          ]
        },
        "validationIntent": {
          "supportingProof": [
            "privacy-leak-proof"
          ],
          "requiredEvidence": [
            "ui-structure-contract"
          ],
          "nonClaims": [
            "Does not prove pixel rendering, typography, spacing, or screenshot visual fidelity.",
            "Does not prove native menu opening, native click routing, focus, or hittability.",
            "Does not prove the live macOS menu bar surface."
          ]
        },
        "artifact": {
          "kind": "ui_structure_contract",
          "path": "build/verification/{scenarioId}/ui-structure-contract.json"
        }
      }
    }
  }
}
