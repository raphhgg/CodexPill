{
  "id": "diagnostics-export-confirmation",
  "title": "Diagnostics export confirmation",
  "featureId": "diagnostics-export",
  "acceptanceCriteria": [
    "diagnostics-export-confirms-before-report",
    "diagnostics-export-cancel-writes-no-report",
    "diagnostics-export-redacted-artifact-only"
  ],
  "targetSurface": "CodexPill Diagnostics menu action, confirmation flow, and diagnostic report builder",
  "validationModes": [
    "unit_only"
  ],
  "suites": [
    "deterministic"
  ],
  "validationIntent": {
    "featureRisk": [
      "privacy",
      "diagnostics",
      "user_confirmation"
    ],
    "primaryProof": "boundary-contract",
    "supportingProof": [
      "workflow-event-log",
      "privacy-leak-proof"
    ],
    "requiredEvidence": [
      "test-output",
      "workflow-receipt",
      "scenario-summary"
    ],
    "nonClaims": [
      "Does not prove live NSSavePanel rendering or file writing.",
      "Does not inspect real local logs, auth snapshots, SSH output, UserDefaults, or Codex session history.",
      "Does not prove live macOS menu-bar interaction."
    ],
    "liveOptIn": {
      "required": false
    }
  },
  "nonRegression": {
    "tier": "changed-feature",
    "runWhen": [
      "local-handoff",
      "diagnostics-export-changed",
      "menu-action-wiring-changed",
      "alert-copy-changed",
      "scenario-fixture-changed"
    ],
    "blocking": true
  },
  "proof": {
    "layer": "boundary-contract",
    "artifactSource": "focused-test-suite",
    "nonClaims": [
      "Does not prove live NSSavePanel rendering or file writing.",
      "Does not inspect real local logs, auth snapshots, SSH output, UserDefaults, or Codex session history.",
      "Does not prove live macOS menu-bar interaction."
    ]
  },
  "command": {
    "run": "make verify-diagnostics-export-confirmation-scenario"
  },
  "expectedArtifacts": [
    {
      "id": "diagnostics-export-confirmation-result-bundle",
      "kind": "test_output",
      "path": "build/results/local/CodexPill.xcresult",
      "claimScope": [
        "diagnostics-menu-alert-report-tests"
      ],
      "redactionStatus": "sanitized"
    },
    {
      "id": "diagnostics-export-confirmation-workflow-receipt",
      "kind": "workflow_event_log",
      "path": "build/verification/diagnostics-export-confirmation/workflow-receipt.json",
      "claimScope": [
        "diagnostics-export-confirmation-events"
      ],
      "redactionStatus": "sanitized"
    },
    {
      "id": "diagnostics-export-confirmation-summary",
      "kind": "reconciliation_report",
      "path": "build/verification/diagnostics-export-confirmation/scenario-summary.json",
      "claimScope": [
        "diagnostics-export-reconciled"
      ],
      "redactionStatus": "sanitized"
    }
  ],
  "expectedMetadata": {
    "scenario": "diagnostics-export-confirmation"
  },
  "privacy": {
    "fixtureData": "synthetic",
    "restrictedEvidence": [
      "account_data",
      "hostname",
      "private_product_data",
      "raw_local_path",
      "raw_transcript",
      "token"
    ]
  }
}
