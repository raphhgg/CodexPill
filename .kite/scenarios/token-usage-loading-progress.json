  "feature": {
    "id": "token-usage-menu-card",
    "title": "Token Usage menu card",
    "acceptanceCriteria": [
      {
        "id": "loading-progress-is-honest-and-private",
        "statement": "When Token Usage is enabled and no cached aggregate exists, CodexPill must show active loading/progress feedback without fake percentages, raw session details, file paths, account, workspace, organization, or remote-host attribution."
      }
    ]
  },
  "targetSurface": "CodexPill hosted menu validation view",
  "suites": [
    "deterministic"
  ],
  "validationIntent": {
    "featureRisk": [
      "ui_visual",
      "temporal",
      "privacy"
    ],
    "supportingProof": [
      "privacy-leak-proof"
    ],
    "requiredEvidence": [
      "screenshot",
      "ui-tree"
    ],
    "nonClaims": [
