      "Does not prove animation cadence over time.",
      "Does not prove close-and-reopen scan lifecycle.",
      "Does not prove reduced-motion runtime behavior.",
      "Does not prove the live macOS menu bar surface."
    ]
  },
  "nonRegression": {
    "runWhen": [
      "local-handoff",
