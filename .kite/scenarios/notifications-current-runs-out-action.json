    "id": "notifications-current-runs-out-action",
    "title": "Notifications Current Runs Out action",
    "acceptanceCriteria": [
      {
        "id": "current-runs-out-fires-for-active-local-or-remote-exhaustion",
        "statement": "Current Runs Out notifications must fire when the active local or remote account becomes exhausted and a fallback account is usable."
      },
      {
        "id": "current-runs-out-copy-and-actions-name-targets",
        "statement": "Current Runs Out notification copy and direct actions must name the exhausted target and the fallback switch target."
      },
      {
        "id": "current-runs-out-actions-recheck-stale-state-before-switch",
        "statement": "Current Runs Out direct actions must re-check current state before switching, substitute safer current targets when possible, and drop stale requests that are no longer actionable."
      }
    ]
  },
  "targetSurface": "CodexPill Current Runs Out notification policy, payload rendering, fake response workflow, and notification action event log",
