{
  "id": "launch-at-login-menu-states",
  "title": "Launch at Login menu states",
  "feature": {
    "id": "launch-at-login-menu-state",
    "title": "Launch at Login menu state",
    "acceptanceCriteria": [
      {
        "id": "menu-states-reflect-login-item-state",
        "statement": "Preferences must present enabled, disabled, requires-approval, and unavailable Launch at Login states truthfully without implying registration success when macOS reports a blocked or unavailable state."
      }
    ]
  },
  "targetSurface": "CodexPill hosted menu validation view",
  "suites": [
    "deterministic"
  ],
  "validationIntent": {
    "featureRisk": [
      "state_truth",
      "ui_visual",
      "privacy"
    ],
    "supportingProof": [
      "boundary-contract",
      "privacy-leak-proof"
    ],
    "requiredEvidence": [
      "screenshot",
      "ui-tree",
      "state-matrix"
    ],
    "nonClaims": [
      "Does not register or unregister the real macOS login item.",
      "Does not open System Settings.",
      "Does not prove a signed app appears in macOS Login Items.",
      "Does not prove the enable confirmation workflow.",
      "Does not prove the live macOS menu bar surface."
    ]
  },
  "nonRegression": {
    "runWhen": [
      "local-handoff",
      "app-controls-ui-changed",
      "launch-at-login-state-changed",
      "menubar-ui-changed",
      "scenario-fixture-changed"
    ]
  },
  "proof": {
    "layer": "boundary-contract",
    "artifactSource": "hosted-validation-view",
    "nonClaims": [
      "Does not register or unregister the real macOS login item.",
      "Does not open System Settings.",
      "Does not prove a signed app appears in macOS Login Items.",
      "Does not prove the enable confirmation workflow.",
      "Does not prove the live macOS menu bar surface."
    ]
  },
  "command": {
    "run": "node scripts/run-kite-scenario.mjs"
  },
  "expectedArtifacts": [
