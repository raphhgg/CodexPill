{
  "id": "launch-at-login-enable-confirmation",
  "title": "Launch at Login enable confirmation",
  "feature": {
    "id": "launch-at-login-enable-confirmation",
    "title": "Launch at Login enable confirmation",
    "acceptanceCriteria": [
      {
        "id": "enable-confirmation-before-register",
        "statement": "Enabling Launch at Login must ask for explicit confirmation before registering the login item."
      },
      {
        "id": "enable-cancel-preserves-disabled-state",
        "statement": "Cancelling the enable confirmation must not call the login-item controller and must leave the disabled state unchanged."
      },
      {
        "id": "disable-unregisters-directly",
        "statement": "Disabling Launch at Login must unregister directly without showing the enable confirmation."
      },
      {
        "id": "enable-failure-remains-truthful",
        "statement": "Registration failure must report an error and must not claim Launch at Login is enabled."
      }
    ]
  },
  "targetSurface": "CodexPill Launch at Login coordinator, confirmation presenter, fake login-item controller, and fake error path",
  "suites": [
    "deterministic"
  ],
  "validationIntent": {
    "featureRisk": [
      "ui_interaction",
      "system_mutation",
      "privacy"
    ],
    "supportingProof": [
      "boundary-contract",
      "workflow-event-log",
      "privacy-leak-proof"
    ],
    "requiredEvidence": [
      "test-output",
      "workflow-receipt",
      "scenario-summary"
    ],
    "nonClaims": [
      "Does not register or unregister the real macOS login item.",
      "Does not prove signed app visibility in System Settings Login Items.",
      "Does not exercise live menu-bar clicks or live System Settings UI."
    ]
  },
  "nonRegression": {
    "runWhen": [
      "local-handoff",
      "app-controls-ui-changed",
      "launch-at-login-state-changed",
      "login-item-controller-changed",
      "alert-copy-changed",
      "scenario-fixture-changed"
    ]
  },
  "proof": {
